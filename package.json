{
  "name": "marlo",
  "version": "0.1.0",
  "private": true,
  "description": "Fixes accessibility violations and proves it.",
  "license": "MIT",
  "author": "Karthik Subramanian",
  "homepage": "https://trymarlo.pages.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KarthikSubramanian07/Marlo.git"
  },
  "bugs": {
    "url": "https://github.com/KarthikSubramanian07/Marlo/issues"
  },
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=9.15.0"
  },
  "scripts": {
    "typecheck": "tsc --build --verbose",
    "build": "pnpm -r --filter './packages/*' run build",
    "lint": "pnpm run lint:code && pnpm run lint:deps && pnpm run lint:prose && pnpm run lint:claims && pnpm run lint:numbers && pnpm run lint:duplicates",
    "lint:code": "NODE_OPTIONS=--max-old-space-size=6144 eslint .",
    "lint:deps": "node scripts/lint-deps.mjs",
    "lint:prose": "node scripts/check-prose.mjs",
    "lint:claims": "node scripts/check-claims.mjs",
    "lint:numbers": "node scripts/check-published-numbers.mjs",
    "lint:duplicates": "node scripts/check-no-duplicates.mjs",
    "raters:check": "node scripts/rater-validity.mjs --check",
    "errors:check": "node scripts/error-analysis.mjs --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "corpus:fetch": "node scripts/fetch-act-corpus.mjs",
    "corpus:verify": "node scripts/verify-act-corpus.mjs && node scripts/verify-real-corpus.mjs",
    "act:index": "node scripts/generate-act-index.mjs",
    "act:index:check": "node scripts/generate-act-index.mjs --check",
    "mappings:discover": "node scripts/discover-mappings.mjs",
    "calibrate": "pnpm run build && node packages/calibrate/dist/bin.js",
    "calibrate:check": "pnpm run build && node packages/calibrate/dist/bin.js --check",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --coverage --project unit --project e2e",
    "test:e2e": "vitest run --project e2e",
    "test:browser": "vitest run --project browser",
    "site:build": "node apps/site/src/build.mjs",
    "site:verify": "node scripts/verify-site.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "deploy": "node scripts/deploy.mjs",
    "release:check": "node scripts/release.mjs --check",
    "release": "node scripts/release.mjs",
    "mcp": "node packages/mcp/dist/bin.js",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run corpus:verify && pnpm run act:index:check && pnpm run test && pnpm run raters:check && pnpm run errors:check && pnpm run test:e2e",
    "hooks": "lefthook install",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@trymarlo/act": "workspace:*",
    "@trymarlo/calibrate": "workspace:*",
    "@trymarlo/cli": "workspace:*",
    "@trymarlo/engines": "workspace:*",
    "@trymarlo/mcp": "workspace:*",
    "@trymarlo/render": "workspace:*",
    "@trymarlo/report": "workspace:*",
    "@trymarlo/rules": "workspace:*",
    "@trymarlo/schema": "workspace:*",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "4.1.11",
    "dependency-cruiser": "18.5.0",
    "eslint": "10.12.0",
    "eslint-plugin-import-x": "4.17.1",
    "fast-check": "4.10.2",
    "lefthook": "2.2.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook",
      "workerd"
    ],
    "overrides": {
      "sharp": ">=0.35.5",
      "source-map-js": ">=1.2.2",
      "undici": "^7.29.1",
      "nanoid": ">=3.3.18"
    }
  },
  "dependencies": {
    "zod": "4.6.5"
  }
}
