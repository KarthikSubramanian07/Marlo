{
  "name": "@marlo/calibrate",
  "version": "0.1.0",
  "description": "Measures every engine against the official ACT test cases and publishes the calibration table.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "marlo-calibrate": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "@marlo/act": "workspace:*",
    "@marlo/engines": "workspace:*",
    "@marlo/render": "workspace:*",
    "@marlo/rules": "workspace:*",
    "@marlo/schema": "workspace:*",
    "zod": "4.4.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
