{
  "name": "@trymarlo/calibrate",
  "version": "0.1.0",
  "description": "Measures every engine against the official ACT test cases and publishes the calibration table.",
  "license": "MIT",
  "author": "Karthik Subramanian",
  "homepage": "https://trymarlo.pages.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KarthikSubramanian07/Marlo.git",
    "directory": "packages/calibrate"
  },
  "bugs": {
    "url": "https://github.com/KarthikSubramanian07/Marlo/issues"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "calibration",
    "act-rules"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "marlo-calibrate": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build && esbuild src/marlo-browser-entry.ts --bundle --format=iife --global-name=MarloRules --platform=browser --target=es2022 --outfile=dist/marlo.browser.js --log-level=warning"
  },
  "dependencies": {
    "@trymarlo/act": "workspace:*",
    "@trymarlo/engines": "workspace:*",
    "@trymarlo/render": "workspace:*",
    "@trymarlo/rules": "workspace:*",
    "@trymarlo/schema": "workspace:*",
    "zod": "4.6.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
