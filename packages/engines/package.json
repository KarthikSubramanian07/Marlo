{
  "name": "@trymarlo/engines",
  "version": "0.1.0",
  "description": "Peer engine adapters, and the hand-written mapping from each engine's rule identifiers to ACT rule identifiers.",
  "license": "MIT",
  "author": "Karthik Subramanian",
  "homepage": "https://trymarlo.pages.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KarthikSubramanian07/Marlo.git",
    "directory": "packages/engines"
  },
  "bugs": {
    "url": "https://github.com/KarthikSubramanian07/Marlo/issues"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "axe-core",
    "alfa",
    "htmlcs"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build && esbuild src/alfa/browser-entry.ts --bundle --format=iife --global-name=MarloAlfa --platform=browser --target=es2022 --outfile=dist/alfa.browser.js --log-level=warning"
  },
  "dependencies": {
    "@trymarlo/act": "workspace:*",
    "@trymarlo/render": "workspace:*",
    "@trymarlo/schema": "workspace:*",
    "@siteimprove/alfa-act": "0.119.0",
    "@siteimprove/alfa-device": "0.119.0",
    "@siteimprove/alfa-dom": "0.119.0",
    "@siteimprove/alfa-http": "0.119.0",
    "@siteimprove/alfa-rules": "0.119.0",
    "@siteimprove/alfa-url": "0.119.0",
    "@siteimprove/alfa-web": "0.119.0",
    "axe-core": "4.14.0",
    "html_codesniffer": "2.5.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
