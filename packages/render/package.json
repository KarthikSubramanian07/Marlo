{
  "name": "@trymarlo/render",
  "version": "0.1.0",
  "description": "The renderer seam and the capability model. What Marlo is allowed to conclude depends on what rendered the page.",
  "license": "MIT",
  "author": "Karthik Subramanian",
  "homepage": "https://trymarlo.pages.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KarthikSubramanian07/Marlo.git",
    "directory": "packages/render"
  },
  "bugs": {
    "url": "https://github.com/KarthikSubramanian07/Marlo/issues"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "happy-dom",
    "playwright"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "@trymarlo/schema": "workspace:*",
    "happy-dom": "21.0.4"
  },
  "peerDependencies": {
    "playwright": ">=1.49.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
