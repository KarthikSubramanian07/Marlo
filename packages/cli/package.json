{
  "name": "@trymarlo/cli",
  "version": "0.1.0",
  "description": "The marlo command.",
  "license": "MIT",
  "author": "Karthik Subramanian",
  "homepage": "https://trymarlo.pages.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KarthikSubramanian07/Marlo.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/KarthikSubramanian07/Marlo/issues"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "cli",
    "wcag",
    "sarif"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "calibration",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build",
    "prepack": "node ../../scripts/stage-calibration.mjs",
    "postpack": "node ../../scripts/stage-calibration.mjs --clean"
  },
  "dependencies": {
    "@trymarlo/act": "workspace:*",
    "@trymarlo/calibrate": "workspace:*",
    "@trymarlo/engines": "workspace:*",
    "@trymarlo/render": "workspace:*",
    "@trymarlo/repair": "workspace:*",
    "@trymarlo/report": "workspace:*",
    "@trymarlo/rules": "workspace:*",
    "@trymarlo/schema": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "marlo": "./dist/bin.js"
  }
}
