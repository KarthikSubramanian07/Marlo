root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.md]
# Trailing whitespace is a hard line break in Markdown.
trim_trailing_whitespace = false
max_line_length = off

[*.{json,jsonc,yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab

[corpus/**]
# Vendored under the W3C Software and Document Licence. Do not reformat.
insert_final_newline = false
trim_trailing_whitespace = false
