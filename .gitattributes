* text=auto eol=lf

# Vendored corpora, corpus/act and corpus/real: byte-exact, digest-verified. Never normalise.
corpus/** -text -diff linguist-vendored

# Except the real-page adjudication record, which people write by hand. A disagreement log
# nobody can read in review is not a log, so these files are ordinary diffable text.
corpus/real/adjudication/** text eol=lf diff -linguist-vendored

# Golden files. A diff here is the point, so keep them readable in review.
tests/golden/** text eol=lf
docs/screenshots/** binary
*.png binary
*.woff2 binary

pnpm-lock.yaml linguist-generated merge=binary
calibration/table.json linguist-generated
